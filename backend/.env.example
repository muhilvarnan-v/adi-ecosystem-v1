# App
APP_NAME=AID
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Firestore — set GOOGLE_APPLICATION_CREDENTIALS to your service account JSON path
# or use Application Default Credentials in GCP
FIRESTORE_PROJECT_ID=your-gcp-project-id

# OAuth redirect base (backend URL)
OAUTH_REDIRECT_BASE=http://localhost:8000

# Jira (Atlassian Cloud OAuth 2.0)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_SCOPES=read:jira-work write:jira-work offline_access

# Trello (OAuth 1.0a — Trello does not support OAuth 2.0)
TRELLO_API_KEY=
TRELLO_API_SECRET=

# GitHub (OAuth 2.0 — link application repos and import skills)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPES=read:user repo

# Zendesk (OAuth 2.0 — import goals from support tickets)
# Create an OAuth client in Admin Center → Apps and integrations → APIs → OAuth clients
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_SCOPES=read

# GCP Agent Platform Skill Registry
AGENT_PLATFORM_PROJECT_ID=your-gcp-project-id
AGENT_PLATFORM_LOCATION=us-central1

# Gemini Managed Agents (goal execution) — API key auth
GEMINI_AUTH_MODE=api_key
GEMINI_API_KEY=your-api-key-from-https://aistudio.google.com/apikey

# OpenHands coding agent (LiteLLM / OpenAI-compatible gateway)
# Host-only URLs are normalized to …/v1 in the coding-agents runner. If you still see
# litellm 403 with an HTML body, run:  cd "coding agents" && ./.venv/bin/python probe_llm_gateway.py
LLM_API_KEY=
LLM_BASE_URL=https://your-litellm-host/v1
LLM_MODEL=openai/your-model-id
# Optional: clone private repos / create PRs when GitHub OAuth token is absent
# GITHUB_TOKEN=
