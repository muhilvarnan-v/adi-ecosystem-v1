# --- OpenHands LLM config (required) ---
# LLM provider key for your selected model/provider.
LLM_API_KEY=your-llm-api-key

# Optional: model + base URL override.
LLM_MODEL=openhands/gpt-5-mini-2025-08-07
# OpenAI-compatible API base. Host-only URLs are auto-appended with /v1 in the runner.
# If chat still returns 403 HTML while GET /v1/models works, the gateway is blocking
# POST /v1/chat/completions (VPN / Cloud Armor / policy) — see probe_llm_gateway.py.
# LLM_BASE_URL=https://your-litellm-host/v1

# --- GitHub auth (recommended for private repos and PR creation) ---
# If `gh` is already authenticated, this may be unnecessary.
# GITHUB_TOKEN=ghp_...

